rules_version = '2';

// Role-based rules (Firebase Authentication).
//
// Design: all writes and all student/advisor reads go through the Backend
// (Cloud Functions + Admin SDK, which bypasses these rules). See
// technology-stack.md section 3. The only direct client access is READ of
// chatMessages by lecturer/admin reviewers (review queue).
//   - NFR-04: students never read chatMessages directly (approved-only
//     filtering happens in the Backend)
//   - NFR-06: senderName is visible only to reviewers here; the Backend strips
//     it for everyone else
//   - NFR-05 / NFR-07: auditEvents and configChangeAudits are never readable
//     or writable by a client
//   - FR-25: legacy connection credentials never reach a client
//
// ASSUMPTION: the role comes from users/{request.auth.uid}.roles, so the
// users document id MUST equal the Firebase Auth uid. The seeded users
// (user-001 ...) do not match any Auth uid, so no seeded account can pass
// these rules until real accounts are created with matching ids.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Active account holding at least one of the reviewer roles.
    function isReviewer() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().status == 'active'
        && userDoc().roles.hasAny(['lecturer', 'admin']);
    }

    match /chatMessages/{messageId} {
      allow read: if isReviewer();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
