rules_version = '2';

// Deny all direct client access to every collection.
//
// Why: the design routes ALL reads and writes through the Backend Service
// (architecture.md, technology-stack.md section 3). The Backend and the seed
// script use the Admin SDK, which bypasses these rules, so they keep working.
// Denying clients covers:
//   - NFR-06: chatMessages.senderName must be stripped by the Backend before
//     anything reaches a Client
//   - NFR-04: only approved messages may be readable, filtered at one point
//   - NFR-05 / NFR-07: auditEvents and configChangeAudits are append-only and
//     written by the Backend only
//   - FR-25: legacy connection credentials must never reach a Client
//
// If a Client ever needs direct Firestore access, replace this with
// per-collection rules and review technology-stack.md section 3 first.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
